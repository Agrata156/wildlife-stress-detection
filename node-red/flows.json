    {
        "id": "16a421f9acee14c4",
        "type": "function",
        "z": "a4a837db21b3cf17",
        "name": "Process readings",
        "func": "\nlet data = msg.payload;\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        return null;\n    }\n}\nconst items = Array.isArray(data) ? data : (data.items || data.Items || data.readings || []);\nconst threshold = 60;\nconst latest = {};\nfor (const r of items) {\n    if (!r.animal_id || typeof r.stress_score !== \"number\") continue;\n    const current = latest[r.animal_id];\n    if (!current || String(r.timestamp) > String(current.timestamp)) latest[r.animal_id] = r;\n}\nconst animals = Object.values(latest).sort((a, b) => b.stress_score - a.stress_score);\nconst statusRows = animals.slice(0, 20).map((r) => ({\n    animal: r.animal_id,\n    region: r.region,\n    status: r.stress_score >= 80 ? \"HIGH\" : r.stress_score >= threshold ? \"MEDIUM\" : r.stress_score > 0 ? \"LOW\" : \"OK\",\n    score: r.stress_score,\n    cause: r.cause || \"none\",\n    heart_rate: r.heart_rate,\n    body_temp: r.temp,\n    ambient_temp: r.env_ambient_temp ?? \"-\",\n    time: r.timestamp\n}));\nconst regions = {};\nfor (const r of animals) {\n    if (!regions[r.region]) regions[r.region] = { region: r.region, animals: 0, stressed: 0, total: 0, max: 0 };\n    const g = regions[r.region];\n    g.animals++;\n    g.total += r.stress_score;\n    g.max = Math.max(g.max, r.stress_score);\n    if (r.stress_score >= threshold) g.stressed++;\n}\nconst regionRows = Object.values(regions).map((g) => ({\n    region: g.region,\n    animals: g.animals,\n    stressed: g.stressed,\n    avg_score: Math.round(g.total / g.animals),\n    max_score: g.max\n}));\nconst chartMsgs = regionRows.map((g) => ({ topic: g.region, payload: g.avg_score }));\nconst seen = context.get(\"alerted\") || {};\nconst newAlerts = [];\nfor (const r of animals) {\n    if (r.stress_score >= threshold) {\n        if (!seen[r.animal_id]) newAlerts.push(r);\n        seen[r.animal_id] = true;\n    } else {\n        delete seen[r.animal_id];\n    }\n}\ncontext.set(\"alerted\", seen);\nconst alertMsg = newAlerts.length\n    ? { payload: newAlerts.map((r) => `${r.animal_id} (${r.region}): ${r.cause}, score ${r.stress_score}`).join(\" | \") }\n    : null;\nconst stressedTotal = regionRows.reduce((sum, g) => sum + g.stressed, 0);\nnode.status({ fill: stressedTotal ? \"red\" : \"green\", shape: \"dot\", text: `${animals.length} animals, ${stressedTotal} stressed` });\nreturn [{ payload: statusRows }, { payload: regionRows }, chartMsgs, alertMsg];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
