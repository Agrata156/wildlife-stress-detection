        "name": "Get readings",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://6lc8pwd1d4.execute-api.us-east-1.amazonaws.com/default/getReadingsFunction",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
